# Acronous AI - Contabo VPS Environment Variables (Cloud VPS 8, 24GB RAM / 300GB disk)
# Copy this to .env and fill in your values

# ── Brain (served by local Ollama Qwen3:8B on the VPS — 167.86.104.155) ──
ACRONOUS_LLM_PROVIDER=contabo
ACRONOUS_LLM_API_URL=http://ollama:11434/v1
ACRONOUS_LLM_MODEL=qwen3:8b
ACRONOUS_LLM_CHAT_MODEL=qwen3:8b
ACRONOUS_LLM_CODE_MODEL=qwen2.5-coder:7b
ACRONOUS_LLM_FAST_MODEL=qwen2.5:3b
ACRONOUS_VISION_MODEL=qwen2.5vl:7b
OLLAMA_MODEL=qwen3:8b
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ── Self-train loop (smarter daily, NEVER fills the VPS) ──
# Quick-scan internet learning: 300s | dataset distill: 21600s (6h) | LoRA: GPU-only
ACRONOUS_SELF_TRAIN=true
ACRONOUS_SELF_TRAIN_INTERVAL=21600
ACRONOUS_SELF_TRAIN_MIN_FACTS=500
ACRONOUS_SELF_TRAIN_MAX_RAM_PCT=85
ACRONOUS_SELF_TRAIN_MIN_FREE_GB=40
ACRONOUS_SELF_TRAIN_MAX_TRAIN_GB=25
ACRONOUS_SELF_TRAIN_MAX_PAIRS_PER_CYCLE=400
ACRONOUS_SELF_TRAIN_MAX_MERGED_PAIRS=20000
ACRONOUS_SELF_TRAIN_RETAIN_DAYS=14
ACRONOUS_SELF_TRAIN_RETAIN_SNAPSHOTS=7

# ── Domain (set after DNS setup) ──
# DOMAIN=ai.acronous.com
# ACRONOUS_BRAIN_HOST=brain.acronous.com
