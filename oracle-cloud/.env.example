# Acronous AI - Oracle Cloud Environment Variables
# Copy this to .env and fill in your values

# ── Required ──
# (LLM inference is served by the local Ollama instance on Oracle Cloud)

# ── Optional (defaults work fine) ──
# VISION_MODEL=google/gemini-2.5-flash-lite
# FAST_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_VISION_MODEL=llava:7b

# ── Domain (set after DNS setup) ──
# DOMAIN=ai.acronous.com
